<?xml version="1.0" encoding="UTF-8"?>
<!--
  WPML configuration of the ISHF 2027 theme (read by WPML when the theme is active).
  translate = edited per language in the translation editor
  copy      = always the same value as the original (changing the original updates the translations)
  copy-once = copied when the translation is created, then free to differ
  ignore    = internal, not translated
  Post types and taxonomies (translatable or not) stay in WPML > Settings.
-->
